{
  "name": "obsidian-superpowers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.3",
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/build.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "check": "bun run typecheck && bun run test && bun run build && bun run verify:mobile",
    "verify:mobile": "node --experimental-strip-types scripts/verify-mobile.ts",
    "verify:desktop": "node --experimental-strip-types scripts/verify-desktop.ts",
    "dev:vault": "bun scripts/dev-vault.ts",
    "dev:obsidian": "bun run build && bun run dev:vault && bun scripts/open-obsidian.ts",
    "eval": "node --experimental-strip-types scripts/eval.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/google": "^4.0.64",
    "@ai-sdk/openai": "^4.0.60",
    "@ai-sdk/react": "^4.0.96",
    "@assistant-ui/react": "^0.15.18",
    "@assistant-ui/react-ai-sdk": "^1.4.9",
    "@assistant-ui/react-markdown": "^0.14.14",
    "ai": "^7.0.93",
    "esbuild-wasm": "^0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2"
  }
}
